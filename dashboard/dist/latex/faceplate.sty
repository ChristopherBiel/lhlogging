  \begin{tikzpicture}[x=\fp@u, y=-\fp@u, line cap=round, line join=round, baseline=\fp@w@platebase]
    \fill[fpPlateSageBackground] (0,0) rectangle (64,64);
    \fp@mark@draw{fpPlateSageColor}{\fp@mark@op@sage}
  \end{tikzpicture}}}


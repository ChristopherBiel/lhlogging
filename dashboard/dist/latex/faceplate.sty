%% ------------------------------------------------------------ switches
%% Declared once per document, like data-fp-intensity on the web. Intensity is
%% a real switch here too: it selects the dial's values further down, and the
%% classes draw from them. Theme is light until dark is defined.
\def\fpintensity{02}
\def\fplevel{personal}
\def\fp@medium{print}
\newif\iffp@fonts \fp@fontstrue
\DeclareKeys[faceplate]{
  intensity.code  = \def\fpintensity{#1},
  intensity.usage = load,
  level.code      = \def\fplevel{#1},
  level.usage     = load,
  fonts.code      = \csname fp@fonts#1\endcsname,
  fonts.usage     = load,
  medium.code     = \def\fp@medium{#1},
  medium.usage    = load,
}
\ProcessKeyOptions[faceplate]
\edef\fpintensity{0\the\numexpr\fpintensity\relax}
\ifnum\fpintensity<1 \PackageError{faceplate}{intensity must be 01, 02, 03 or 04}{}\fi
\ifnum\fpintensity>4 \PackageError{faceplate}{intensity must be 01, 02, 03 or 04}{}\fi
\@namedef{fp@level@personal}{}\@namedef{fp@level@project}{}\@namedef{fp@level@neutral}{}
\ifcsname fp@level@\fplevel\endcsname\else
  \PackageError{faceplate}{level must be personal, project or neutral}{}
\fi
\@namedef{fp@medium@print}{}\@namedef{fp@medium@slides}{}
\ifcsname fp@medium@\fp@medium\endcsname\else
  \PackageError{faceplate}{medium must be print or slides}{}
\fi


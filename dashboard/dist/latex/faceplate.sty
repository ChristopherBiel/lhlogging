%% Colour is also a code: a section belongs to one of three kinds, and its
%% index square and its accents take that kind's colour. \fpkind{sage} is the
%% work itself (the default), {ink} what is public and dated, {terra} what is
%% made on the side. It sets fpKind, fpKindTint, fpKindDeep and the square's
%% fill, which steps with the dial: paper, then the tint, then the solid colour.
%% Global, because a section is not a group: it may run across a page break.
\def\fp@kind@set#1#2#3#4{%
  \xglobal\colorlet{fpKind}{#1}\xglobal\colorlet{fpKindTint}{#2}\xglobal\colorlet{fpKindDeep}{#3}%
  \xglobal\colorlet{fpCtxAccent}{#4}%
  \ifnum\fpintensity<2 \xglobal\colorlet{fpKindFill}{fpBg}%
  \else\ifnum\fpintensity<3 \xglobal\colorlet{fpKindFill}{#2}%
  \else\xglobal\colorlet{fpKindFill}{#1}\fi\fi}
\@namedef{fp@kind@sage}{\fp@kind@set{fpSage}{fpSageTint}{fpSageDeep}{fpSage}}
\@namedef{fp@kind@ink}{\fp@kind@set{fpInk}{fpGrey}{fpInk}{fpSage}}
\@namedef{fp@kind@terra}{\fp@kind@set{fpTerra}{fpTerraTint}{fpTerraDeep}{fpTerra}}
\newcommand\fpkind[1]{%
  \ifcsname fp@kind@#1\endcsname\csname fp@kind@#1\endcsname\else
    \PackageError{faceplate}{Unknown kind `#1'}{A section is sage, ink or terra.}\fi}
\colorlet{fpKindFillInk}{fpFillInk}
\fpkind{sage}

%% ------------------------------------------------------------- details
%% Labels are uppercased; colour names inside them must not be. Text macros
%% start a paragraph first (as \textcolor does), so a colour switch never
%% becomes the first item of a box and throws off baseline alignment.
\ExplSyntaxOn
\tl_put_right:Nn \l_text_case_exclude_arg_tl { \color \textcolor }
\ExplSyntaxOff
%% The accent rule under a heading.
\newcommand\fprule{{\color{fpRuleColor}\rule{36pt}{3pt}}}
%% A mono label: uppercase, tracked out, quiet. [colour] defaults to the label role.
\newcommand\fplabel[2][fpLabelColor]{\leavevmode{\fp@labelfont\fpsize{xs}\color{#1}\MakeUppercase{#2}}}
%% A kicker: a label above a heading. Deep sage, because it is small text.
\newcommand\fpkicker[1]{\fplabel[fpSageDeep]{#1}}
%% Mono, untracked and in its own case: dates, figures, addresses.
\newcommand\fpmono[1]{\leavevmode{\ttfamily #1}}
%% The wordmark, or display type.
\newcommand\fpwordmark[1]{\leavevmode{\fp@wordmarkfont\color{fpInk}#1}}
%% A hairline divider across the line, in the signature grey.
\newcommand\fphr{\par\noindent{\color{fpGrey}\rule{\linewidth}{\fphairline}}\par}

%% Registration marks: four corners where a frame would be. They take the
%% level's line weight and the colour of the field they stand on.
%% \fpreg[<distance outside>]{<content>} puts them around anything.
\newdimen\fp@dim
\newbox\fp@box
\def\fp@reglen{6pt}       % the length of one stroke of a mark
\def\fp@barwidth{3pt}     % the accent bar: the weight of the accent rule
\newcommand\fp@marks[4]{% width, height, depth, distance outside — drawn from here, taking no room
  \begingroup\color{fpCtxMark}%
  \dimen0=\dimexpr#4\relax \dimen2=\dimexpr#1+\dimen0\relax
  \dimen4=\dimexpr#2+\dimen0\relax \dimen6=\dimexpr-#3-\dimen0\relax
  \dimen8=\fp@reglen\relax
  \rlap{\kern-\dimen0 \rule[\dimen6]{\dimen8}{\fpline}}%
  \rlap{\kern-\dimen0 \rule[\dimen6]{\fpline}{\dimen8}}%
  \rlap{\kern\dimexpr\dimen2-\dimen8\relax \rule[\dimen6]{\dimen8}{\fpline}}%
  \rlap{\kern\dimexpr\dimen2-\fpline\relax \rule[\dimen6]{\fpline}{\dimen8}}%
  \rlap{\kern-\dimen0 \rule[\dimexpr\dimen4-\fpline\relax]{\dimen8}{\fpline}}%
  \rlap{\kern-\dimen0 \rule[\dimexpr\dimen4-\dimen8\relax]{\fpline}{\dimen8}}%
  \rlap{\kern\dimexpr\dimen2-\dimen8\relax \rule[\dimexpr\dimen4-\fpline\relax]{\dimen8}{\fpline}}%
  \rlap{\kern\dimexpr\dimen2-\fpline\relax \rule[\dimexpr\dimen4-\dimen8\relax]{\fpline}{\dimen8}}%
  \endgroup}
\newcommand\fpreg[2][0pt]{\leavevmode\begingroup
  \setbox\fp@box\hbox{#2}%
  \fp@marks{\wd\fp@box}{\ht\fp@box}{\dp\fp@box}{#1}\box\fp@box\endgroup}

%% \fpindex{01} — the index square: a section's number on its kind's fill. It
%% is the first thing to take colour: between four marks at 01, tinted at 02,
%% solid from 03, and larger with every step from 03.
\newcommand\fpindex[1]{\leavevmode\begingroup
  \fp@dim=\fp@dial@indexSize\relax
  \rlap{\color{fpKindFill}\rule{\fp@dim}{\fp@dim}}%
  \ifnum\fpintensity<3 \fp@marks{\fp@dim}{\fp@dim}{0pt}{0pt}\fi
  \hbox to\fp@dim{\hss\vbox to\fp@dim{\vss
    \hbox{\fp@wordmarkfont\fpsize{index}\color{fpKindFillInk}#1}\vss}\hss}%
  \endgroup}

%% \fptickrule[<columns>]{<width>}{<gutter>} — the rule that opens a section,
%% with a ruler tick at the start of every column. The grid shows without
%% being drawn. It takes the height of the line; the ticks hang below it.
\newcommand\fptickrule[3][12]{\leavevmode\begingroup
  \fp@dim=\dimexpr(#2+#3)/#1\relax
  \setbox\fp@box\hbox to\dimexpr#2\relax{%
    \rlap{\color{fpLineColor}\rule{\dimexpr#2\relax}{\fpline}}%
    \count@=\z@
    \loop\ifnum\count@<#1\relax
      \rlap{\kern\count@\fp@dim \color{fpCtxMark}\rule[\dimexpr\fpline-6pt\relax]{\fpline}{6pt}}%
      \advance\count@\@ne
    \repeat\hss}%
  \ht\fp@box=\fpline \dp\fp@box=\z@ \box\fp@box\endgroup}


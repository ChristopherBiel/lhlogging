  \begin{tikzpicture}[x=\fp@u, y=-\fp@u, line cap=round, line join=round, baseline=\fp@w@platebase]
    \fill[fpPlateBackground] (0,0) rectangle (64,64);
    \fp@mark@draw{fpPlateColor}{\fp@mark@op@plate}
  \end{tikzpicture}}}
%% \fpmarkonsage{<size>} — reversed, on a sage square.
\newcommand\fpmarkonsage[1]{{%

  \pgfmathsetlengthmacro\fp@w@off{\fp@mark@dashoff*\fp@u}%
  %% baselines as lengths: a coordinate here would be read in TikZ's default 1cm units
  \pgfmathsetlengthmacro\fp@w@inkbase{-\fp@mark@bottom*\fp@u}%
  \pgfmathsetlengthmacro\fp@w@platebase{-64*\fp@u}}
\newcommand\fp@mark@draw[2]{% #1 colour, #2 setpoint opacity
  \draw[#1, opacity=#2, line width=\fp@w@set, dash pattern=on \fp@w@on off \fp@w@off] \fp@mark@set;
  \draw[#1, line width=\fp@w@curve] \fp@mark@path;
  \fill[#1] \fp@mark@dot circle[radius=\fp@mark@dotr];}
%% \fpmark[<colour>]{<size>} — the bare mark, sage by default.
\newcommand\fpmark[2][fpSage]{{%
  \fp@mark@units{#2}%
  \begin{tikzpicture}[x=\fp@u, y=-\fp@u, line cap=round, line join=round,
      baseline=\fp@w@inkbase]
    \fp@mark@draw{#1}{\fp@mark@op@bare}
    \pgfresetboundingbox
    \useasboundingbox (\fp@mark@left,\fp@mark@top) rectangle (\fp@mark@right,\fp@mark@bottom);
  \end{tikzpicture}}}
%% \fpmarkplate{<size>} — ink on the signature-grey plate.
\newcommand\fpmarkplate[1]{{%

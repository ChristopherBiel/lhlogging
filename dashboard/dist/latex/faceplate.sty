%% ---------------------------------------------------------------- type
%% Manrope ships beside this file in fonts/ (SIL OFL); IBM Plex Mono comes
%% with TeX Live. Manrope has no italic: emphasis is SemiBold, never a slant.
\iffp@fonts\ifPDFTeX
  \PackageWarningNoLine{faceplate}{pdfLaTeX cannot load Manrope and IBM Plex Mono.\MessageBreak
    Compile with LuaLaTeX (or XeLaTeX) for the brand typefaces.\MessageBreak
    Colours, lengths and macros still work}
  \fp@fontsfalse
\fi\fi
\iffp@fonts
  \RequirePackage{fontspec}
  \IfFontExistsTF{Manrope-Regular.ttf}{}{%
    \PackageError{faceplate}{Manrope not found}{Run `npx faceplate install-latex' once on this machine,\MessageBreak
      or (Overleaf) upload the fonts/ folder next to your document.}}
  \defaultfontfeatures[Manrope]{
    Extension = .ttf, UprightFont = *-Regular, BoldFont = *-Bold,
    ItalicFont = *-SemiBold, BoldItalicFont = *-Bold,
    FontFace = {mb}{n}{*-Medium}, FontFace = {sb}{n}{*-SemiBold},
    FontFace = {eb}{n}{*-ExtraBold}}
  \defaultfontfeatures[IBMPlexMono]{
    Extension = .otf, UprightFont = *-Regular, BoldFont = *-SemiBold,
    ItalicFont = *-Italic, BoldItalicFont = *-SemiBoldItalic,
    FontFace = {mb}{n}{*-Medium}}
  \setmainfont{Manrope}
  \setsansfont{Manrope}
  \setmonofont{IBMPlexMono}
  %% labels: Plex Mono Medium, tracked out
  \newfontfamily\fp@labelfont{IBMPlexMono}[
    UprightFont = *-Medium, LetterSpace = 12]
  %% the wordmark and display type: ExtraBold, tracked tight
  \newfontfamily\fp@wordmarkfont{Manrope}[
    UprightFont = *-ExtraBold, BoldFont = *-ExtraBold,
    LetterSpace = -2]
  %% headings: Bold, tracked in slightly
  \newfontfamily\fp@headingfont{Manrope}[
    UprightFont = *-Bold, BoldFont = *-ExtraBold,
    LetterSpace = -1]
  %% the display line: Bold or ExtraBold as the dial says, tracked tighter still
  \newfontfamily\fp@displayfont{Manrope}[
    UprightFont = *-Bold, BoldFont = *-ExtraBold,
    LetterSpace = -3]
\else
  \def\fp@labelfont{\ttfamily}
  \def\fp@wordmarkfont{\bfseries}
  \def\fp@headingfont{\bfseries}
  \def\fp@displayfont{\bfseries}
\fi

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
TZ=Europe/Berlin

# Nightly Lufthansa flight-status fetch. Fires at 22:00 Europe/Berlin; run_nightly.sh
# then adds a random ≤1h jitter so the actual request lands within 22:00–23:00.
0 22 * * *  root  . /etc/environment && /app/run_nightly.sh >> /var/log/lhlogging/flightstatus.log 2>&1

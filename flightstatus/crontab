SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
TZ=Europe/Berlin
# The door (flightstatus/door.py, 2026-10-30): when three sessions in a row open
# without the bot check and are refused, a run waits this many minutes and tries
# one more, until the next line below is due; then it stops. A run by hand
# (docker compose exec ...) does not have this and stops at once.
FIS_DOOR_WAIT_MIN=15

# Lufthansa flight-status reader: the read plan, every hour (2026-11-01).
#
# Each run asks the feed for what has fallen due since the last one, the most
# valuable first (flightstatus/plan.py, docs/flightstatus_schedule.md "The read
# plan"): the fleet pool by pool, every flight day of a pool once a day out to
# the day the pool is read to, and on top
#
#   747-8, A380        D+9   every 6 h at D+1..D+3, within 12 h and 3 h of departure
#   A350 Allegris      D+9   within 12 h and 3 h of a hub departure
#   787, A350 Munich   D+4   within 12 h and 3 h of a hub departure
#   A350 Frankfurt      -    not read (ADS-B still logs its flights)
#   watched tails     D+3   every 6 h (FIS_WATCH_TAILS, and special liveries)
#
# an outbound through its return leg, which names it as its previousFlight; the
# flown tail from ADS-B, and from the feed where ADS-B did not see it. About 800
# lookups a day, ~30 a run; a run reads at most FIS_DUE_MAX (150). Nothing due:
# no browser, a run of 0 lookups. When the feed is shut (door.py) a run waits
# for it until the next line here, and the next run, finding the run before it
# stopped for that, waits at its first shut session instead of its third.
#
# Until 2026-10-31 there were fifteen passes a day, each reading a fixed set of
# days (sweeps at 05:45 and 18:15, the far pass at 11:20, pulses for the
# 747-8/A380 seven times a day, watches before the departure banks): ~2,270
# lookups a day, which the feed shut since 27 October no longer let through.
# Their modes stay in fetch_flightstatus.py, for runs by hand.
#
# Census (08:40, --census, flightstatus/census.py): of the long-haul block
# LH400-799, the numbers the catalog does not sweep, a sixth a day, asked for at
# D+8. A widebody found on one enters the catalog with the next day's upkeep, a
# week before the flight operates. ~47 lookups, nearly all answered "no such
# flight" at once; between the 08:07 and the 09:07 run (if the 08:07 run is
# still reading, the slot is skipped, like any other).
7  *  * * *  root  . /etc/environment && NIGHTLY_JITTER_MAX_S=600 /app/run_nightly.sh --due >> /var/log/lhlogging/flightstatus.log 2>&1
40 8  * * *  root  . /etc/environment && NIGHTLY_JITTER_MAX_S=300 /app/run_nightly.sh --census >> /var/log/lhlogging/flightstatus.log 2>&1
